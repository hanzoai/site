{
 "signatures": {
  "drag-canvas": {
   "name": "Drag to explore",
   "what": "An infinite canvas the visitor pans with the pointer (or a finger); the product's parts are laid out on it."
  },
  "zoom-map": {
   "name": "Zoom into the system",
   "what": "Scroll zooms from the whole system down into one part, which then fills the screen and explains itself."
  },
  "h-gallery": {
   "name": "Sideways gallery",
   "what": "Vertical scroll drives a horizontal track of panels; the page moves sideways for one stretch, then releases."
  },
  "spotlight": {
   "name": "Spotlight",
   "what": "A dark section the cursor lights up; what is under the light reveals detail (touch: tap to place the light)."
  },
  "compare": {
   "name": "Before / after slider",
   "what": "A divider the visitor drags across two states: without Hanzo and with it, old and new."
  },
  "card-stack": {
   "name": "Card stack",
   "what": "A stack of cards flicked or dragged away one at a time; each card is one idea."
  },
  "terminal": {
   "name": "Live terminal",
   "what": "A terminal types the real commands and streams real output; the visitor can pick the next command."
  },
  "object-3d": {
   "name": "Turn the object",
   "what": "One 3D object (or 2.5D layered render) the visitor drags to rotate; parts label themselves as they face front."
  },
  "film-scrub": {
   "name": "Scrub the film",
   "what": "Scroll scrubs a film or image sequence frame by frame, forwards and back."
  },
  "race": {
   "name": "Live race",
   "what": "Bars, lanes or counters race against each other in real time, at the real ratios."
  },
  "graph": {
   "name": "Living graph",
   "what": "Nodes and links that settle like a physics graph; hovering a node lights its paths and names them."
  },
  "split": {
   "name": "Split screen",
   "what": "One side holds still while the other scrolls and changes it (the old pinned-chapters scene: rationed)."
  },
  "decode": {
   "name": "Decode",
   "what": "Headlines and figures resolve out of scrambled characters as they arrive; hovering re-scrambles them."
  },
  "magnet-grid": {
   "name": "Magnetic grid",
   "what": "A field of tiles or dots that bends toward the cursor and ripples when clicked."
  },
  "timeline": {
   "name": "Drag the timeline",
   "what": "A timeline the visitor drags or scrubs; the page's content changes with the year or step."
  },
  "rows-open": {
   "name": "Rows that open",
   "what": "A tight list whose rows expand in place on hover or tap into a full detail panel."
  },
  "live-chat": {
   "name": "Live conversation",
   "what": "The product answers in real time on screen, with a choice of questions to ask it."
  },
  "flip-board": {
   "name": "Flip board",
   "what": "Departure-board tiles flip through values (statuses, prices, regions) as data changes."
  },
  "ribbons": {
   "name": "Velocity ribbons",
   "what": "Bands of words or logos whose speed and direction follow the scroll and lean with it."
  },
  "peel": {
   "name": "Peel the layers",
   "what": "The product's stack lifts apart into floating layers in 3D, then closes again."
  },
  "word-light": {
   "name": "Words light up",
   "what": "A long statement lights word by word as it is read (story pages)."
  },
  "stamp": {
   "name": "Stamp",
   "what": "Elements land with weight: a short drop, a squash and a settle, like stamping a document."
  },
  "globe": {
   "name": "Globe",
   "what": "A turning globe with live points and arcs between regions; drag to spin it."
  },
  "particles": {
   "name": "Particles form it",
   "what": "A cloud of dots assembles into the product's shape or mark and scatters at the cursor."
  },
  "morph-panel": {
   "name": "One panel, many states",
   "what": "A single panel that morphs smoothly between states as tabs or steps change, never cutting."
  },
  "waveform": {
   "name": "Waveform",
   "what": "A live audio waveform that plays, scrubs and reacts to the pointer (voice and audio pages)."
  },
  "calculator": {
   "name": "Live calculator",
   "what": "Sliders and inputs that reprice or re-plan everything on the page instantly."
  },
  "one-question": {
   "name": "One question at a time",
   "what": "A form that asks one thing per screen, sliding to the next, with the answer summarised as it builds."
  },
  "keep": {
   "name": "Keep as is",
   "what": "James approved this page's motion (7 Nov). Do not change it."
  }
 },
 "entrances": {
  "split-merge": "two halves slide in from left and right and merge into one",
  "curtain-rise": "rises from below behind a clip, like a curtain",
  "drop-in": "falls in from above and settles with a small bounce",
  "iris": "a circular clip opens from the centre",
  "diagonal-wipe": "a diagonal clip sweeps across",
  "letter-cascade": "letters fall into place one by one",
  "word-shuffle": "words arrive out of order and swap into place",
  "grow-from-point": "grows from the point the visitor last clicked or the cursor",
  "fold-out": "unfolds like paper (rotateX from a hinge)",
  "card-deal": "items are dealt from a deck onto their places",
  "slot-roll": "text rolls vertically into place like a slot machine",
  "typewriter": "types itself out with a caret",
  "rack-focus": "comes into focus from a blur, like a camera pulling focus",
  "pixel-resolve": "resolves from coarse pixels to sharp",
  "tile-flip": "a grid of tiles flips in to form it",
  "blinds": "venetian-blind strips open",
  "zoom-through": "flies in from far behind the screen",
  "swing-door": "swings in on a vertical hinge (rotateY)",
  "spring-snap": "snaps in from the side and overshoots on a spring",
  "magnet-gather": "scattered pieces are pulled together into it",
  "explode-gather": "starts as fragments and collapses into the whole",
  "ink-spread": "an organic ink-blot mask spreads to reveal it",
  "line-draw": "its outlines draw themselves, then it fills",
  "count-roll": "its numbers count and roll into their values",
  "stack-drop": "layers drop and stack onto each other",
  "depth-parallax": "layers at different depths move at different speeds",
  "conveyor": "rides in on a horizontal conveyor",
  "shutter": "bars close from top and bottom, then open on it",
  "glitch-in": "a short monochrome glitch, then it holds still",
  "ripple": "a ripple spreads from the centre and leaves it behind",
  "domino": "items tip into place one after another like dominoes",
  "accordion": "unfolds section by section like an accordion",
  "page-curl": "the previous surface curls away at the corner to show it",
  "pendulum": "swings in and settles like a pendulum",
  "orbit-in": "items orbit into their places on a curve",
  "squash-land": "lands with a squash and stretch",
  "focus-pull-scroll": "the background blurs and the subject sharpens as it scrolls in",
  "invert-flash": "a black/white inversion flash, then normal",
  "grid-wave": "a grid ripples in by distance from the cursor",
  "scroll-tilt": "tilts on rotateX with scroll speed and levels out",
  "sticky-stack": "cards stack at the top as you scroll past them",
  "snap-sections": "sections snap one screen at a time",
  "side-carousel": "a horizontal snapping carousel",
  "text-mask-film": "a film plays through the letters of a headline",
  "opposite-drift": "left and right halves drift in opposite directions with scroll",
  "shrink-to-card": "the section shrinks into a card as you leave it",
  "cover-slide": "the next section slides up over the previous one",
  "pull-back": "starts zoomed right in and pulls back to reveal the whole",
  "tilt-3d-hover": "tilts in 3D toward the pointer",
  "cursor-trail": "a trail follows the cursor across it",
  "velocity-skew": "skews with scroll speed and straightens when still",
  "inertia-drag": "can be dragged and thrown with inertia",
  "scramble": "characters scramble and decode into it",
  "underline-sweep": "underlines sweep under key words in sequence",
  "stretch-scroll": "stretches vertically with scroll and relaxes",
  "noise-dissolve": "dissolves in from grain/noise",
  "cursor-lens": "a circular lens follows the cursor and magnifies",
  "vertical-ticker": "rides a vertical ticker into place",
  "spiral-in": "spirals in from the edge to its place",
  "venetian-type": "each line of type slides in from alternating sides"
 },
