[
{
"p": "What a bot is"
},
{
"h2": "A teammate with its own computer"
},
{
"p": "Not a chat window. A bot has a computer of its own and works while you do something else."
},
{
"h3": "Its own computer"
},
{
"p": "Each bot runs in its own sandbox with a browser, a terminal and your apps. Nothing it does touches your machine unless you let it."
},
{
"h3": "Works where you work"
},
{
"p": "Sign it in once. It uses the same tools and websites you do, including the ones that are hard to automate."
},
{
"h3": "Comes back when it is done"
},
{
"p": "Give it a task and go do something else. It returns with finished work and asks only when it needs your say."
}
],
[
{
"p": "Give each bot a job"
},
{
"h2": "One bot per job"
},
{
"h3": "Inbox"
},
{
"p": "Sorts what came in, answers what it can, and parks drafts for your ok."
},
{
"h3": "Sales outreach"
},
{
"p": "Researches accounts, drafts messages in your voice, and leaves a review list."
},
{
"h3": "Research"
},
{
"p": "Reads, compares, and writes up what it found."
},
{
"h3": "Bug reproduction"
},
{
"p": "Reproduces the report, finds the failing step, and files it."
},
{
"h3": "Expenses"
},
{
"p": "Collects the receipts and files the report."
},
{
"h3": "Chief of staff"
},
{
"p": "Keeps the other bots on task and tells you what changed."
}
],
[
{
"p": "Work with many at once"
},
{
"h2": "Bots that hand work to each other"
},
{
"h3": "One gateway, many bots"
},
{
"p": "Each bot has its own workspace, sign-ins and history, and each message goes to the bot it is meant for."
},
{
"h3": "Sub-agents"
},
{
"p": "A bot can start background runs that work in parallel and post what they found back in the chat that asked."
},
{
"h3": "Bots message bots"
},
{
"p": "One bot can read another’s session and send it a message, so a handoff needs no copy and paste."
},
{
"a": "How multi-agent works",
"href": "https://docs.hanzo.bot/docs/concepts/multi-agent"
}
],
[
{
"p": "Show it how it is done"
},
{
"h2": "Teach it a routine once"
},
{
"h3": "Skills"
},
{
"p": "Write the steps in a plain Markdown skill, and the bot uses it whenever the job comes up."
},
{
"h3": "On a schedule"
},
{
"p": "Every morning, or in twenty minutes. Scheduled jobs survive a restart and can post the result to a chat."
},
{
"h3": "Your say at each step"
},
{
"p": "A multi-step routine can stop at the steps you mark and wait for your yes before it goes on."
},
{
"a": "Skills in the docs",
"href": "https://docs.hanzo.bot/docs/tools/skills"
}
],
[
{
"p": "Gets better as it goes"
},
{
"h2": "It remembers what it learns"
},
{
"h3": "Memory is files"
},
{
"p": "Decisions, preferences and running notes go into Markdown files in its workspace, not into the model."
},
{
"h3": "It looks things up"
},
{
"p": "It searches those notes when it needs them, so what you told it last week still counts."
},
{
"h3": "Yours to read and fix"
},
{
"p": "Open the files, correct them or delete them. The next session starts from what you left."
},
{
"a": "How memory works",
"href": "https://docs.hanzo.bot/docs/concepts/memory"
}
],
[
{
"p": "How it starts"
},
{
"h2": "Three steps"
},
{
"h3": "Name it and give it a job"
},
{
"p": "Say what you want done, in plain words."
},
{
"h3": "Sign it in to your tools"
},
{
"p": "Once. It keeps the access it needs and nothing more."
},
{
"h3": "Let it work"
},
{
"p": "It comes back when it is done, or when it needs you."
}
